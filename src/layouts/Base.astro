---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = 'A daily puzzle about how the world says the same things differently.' } = Astro.props;

// Paste your Google Form's share link here; the footer link is hidden while it's empty
const FEEDBACK_URL = 'https://docs.google.com/forms/d/e/1FAIpQLScjb0lii54hf7kejMw3CBwKP7Rp6HpzWmAHYwCwaAbCL2EGFw/viewform?usp=publish-editor';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title ? `${title} · Lost in Meaning` : 'Lost in Meaning'}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🪳</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..800;1,9..144,400..800&family=Inter:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/">Lost <em>in</em> Meaning</a>
      <nav aria-label="Main">
        <a href="/">Today</a>
        <a href="/collection/">Collection</a>
        <button class="help-button" type="button" aria-label="How to play" title="How to play" data-help-open>?</button>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>Language is stranger than you think.</p>
      {
        FEEDBACK_URL && (
          <p>
            <a class="feedback" href={FEEDBACK_URL} target="_blank" rel="noopener">
              Tell us what you think<span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </p>
        )
      }
    </footer>

    <dialog class="help" aria-labelledby="help-heading" data-help>
      <h2 id="help-heading">How to play</h2>
      <p>Every day there's a new idiom from somewhere in the world, translated word for word.</p>
      <ol class="help-steps">
        <li><strong>Guess what it really means.</strong> Pick one of four meanings.</li>
        <li>
          <strong>Wrong? You get a clue:</strong> how another language says the same thing, with a completely different
          image.
        </li>
        <li><strong>Solve it in as few clues as you can.</strong> Run out of clues and the answer is revealed.</li>
        <li><strong>Bonus:</strong> guess which language the idiom comes from.</li>
      </ol>
      <p class="help-example">
        <span><span aria-hidden="true">🟩</span> first try</span>
        <span><span aria-hidden="true">🟥🟩</span> one clue</span>
        <span><span aria-hidden="true">🟥🟥🟥</span> lost in translation</span>
      </p>
      <p class="muted">A new puzzle every day at midnight, New York time.</p>
      <form method="dialog">
        <button class="button" type="submit">Let's play</button>
      </form>
    </dialog>

    <script>
      const help = document.querySelector<HTMLDialogElement>('[data-help]')!;
      document.querySelector('[data-help-open]')!.addEventListener('click', () => help.showModal());
      // Light dismiss: a click on the backdrop lands on the dialog element itself
      help.addEventListener('click', (e) => e.target === help && help.close());

      // Only on puzzle pages: "/" is a redirect page and must not mark it seen
      if (document.querySelector('[data-puzzle]')) {
        const SEEN = 'lim:help-seen';
        let seen = false;
        try {
          seen = localStorage.getItem(SEEN) === '1';
          localStorage.setItem(SEEN, '1');
        } catch {} // blocked storage: show it each visit rather than never
        if (!seen) help.showModal();
      }
    </script>
  </body>
</html>
